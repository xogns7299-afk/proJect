{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:reset:local": "node -e \"require('fs').rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})\" && npm run db:migrate:local",
    "typecheck": "tsc --noEmit",
    "check:api": "node scripts/api-check.mjs",
    "demo:sql": "node scripts/demo/make-seed.mjs",
    "demo:reset:local": "wrangler d1 execute DB --local --file scripts/demo/seed.sql"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
